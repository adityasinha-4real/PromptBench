# ---------------------------------------------------------------------------
# PromptBench configuration
#
# Copy to `.env` and edit:   cp .env.example .env
#
# PromptBench starts with NONE of these set. Every provider that has no
# credential simply reports as unavailable in the UI; the app still runs, and
# Ollama (local, free) needs no key at all.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development          # development | production
DEBUG=false
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database --------------------------------------------------------------
# SQLite by default. For Postgres, install the extra and use:
#   pip install -e "backend[postgres]"
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/promptbench
DATABASE_URL=sqlite+aiosqlite:///./promptbench.db

# --- Provider credentials --------------------------------------------------
# Leave blank to run without that provider. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional base-URL overrides (self-hosted gateways, proxies, Azure, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Ollama (local models — no key required) -------------------------------
# Inside Docker Compose this is set to http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Execution limits ------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=120
CONNECT_TIMEOUT_SECONDS=10
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.5
MAX_CONCURRENCY=8

# --- Input validation limits ----------------------------------------------
MAX_PROMPT_CHARS=32000
MAX_SYSTEM_PROMPT_CHARS=8000
MAX_OUTPUT_TOKENS_LIMIT=8192
MAX_MODELS_PER_BENCHMARK=12
MAX_VARIANTS_PER_BENCHMARK=10

# --- Evaluation ------------------------------------------------------------
# heuristic (offline, default) | llm_judge | manual | disabled
EVALUATION_DEFAULT_MODE=heuristic
# Default judge for llm_judge mode. A local Ollama model keeps judging free:
# JUDGE_PROVIDER=ollama
# JUDGE_MODEL=llama3.2
JUDGE_PROVIDER=
JUDGE_MODEL=

# --- Pricing ---------------------------------------------------------------
# Override the bundled price table with your own negotiated rates.
# PRICING_FILE=/absolute/path/to/pricing.json

# --- Frontend --------------------------------------------------------------
# Browser-visible; must NOT contain secrets.
NEXT_PUBLIC_API_URL=http://localhost:8000
